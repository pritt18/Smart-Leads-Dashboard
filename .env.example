# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/leadflow
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/leadflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/leadflow

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=24h

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000
